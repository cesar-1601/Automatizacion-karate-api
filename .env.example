# Datos de ejemplo para ejecutar las pruebas contra CAL.
# Los valores escritos directamente en el comando tienen prioridad.
# Copia este archivo como .env solo si tu herramienta local lo requiere.
# No agregues tarjetas, CVV, OTP, llaves privadas ni contrasenas aqui.

# Conexion y rutas de los servicios
KARATE_ENV=cal
BASE_URL=http://10.10.176.150:8299
RSA_PUBLIC_KEY_PATH=/seguridad/cal/canales/llaves-publicas/consulta
APLICACION_ID=PTP
CANAL_ID=IN

# Llave publica y datos de la tarjeta de prueba.
# La llave publica normalmente se obtiene automaticamente.
PUBLIC_KEY_BASE64=
CARD_NUMBER=
MASKED_CARD=
EXPIRATION_DATE=
CVV=

# Comercio y condiciones del credito
MERCHANT_CODE=
MERCHANT_ID=cal-default
MATRIX_ID=1
CREDIT_GROUP=C
CREDIT_TYPE=00
INSTALLMENTS=1
TRANSACTION_AMOUNT=500

# Codigo OTP y datos generales del proceso
OTP=000000
PROFILE=S
TRANSACTION_CODE=PTP